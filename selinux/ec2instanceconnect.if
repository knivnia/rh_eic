## <summary>EC2 Instance Connect AuthorizedKeysCommand helper.</summary>

########################################
## <summary>
##	Execute eic-run in the eic domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to transition.
##	</summary>
## </param>
#
interface(`eic_domtrans',`
	gen_require(`
		type eic_t, eic_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, eic_exec_t, eic_t)
	allow $1 eic_t:process2 { nnp_transition nosuid_transition };
')
